# Required
OPENROUTER_API_KEY=
# Any vision-capable OpenRouter model, e.g. google/gemini-2.5-flash
OPENROUTER_MODEL=

# Optional
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TEMPERATURE=0.2
OPENROUTER_MAX_TOKENS=16384
OPENROUTER_TIMEOUT_MS=120000
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=vector
# Optional JSON provider-routing object, passed through to OpenRouter.
# OPENROUTER_PROVIDER={"order":["google-vertex"]}

PROMPT_PATH=prompts/vectorize.md
MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_DIMENSION=1568
MAX_CONCURRENCY=4
MAX_QUEUE=32
RETRY_ON_INVALID_SVG=1
REQUEST_TIMEOUT_MS=150000
