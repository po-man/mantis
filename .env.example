# Required
OPENROUTER_API_KEY=
# Any vision-capable OpenRouter model. Default: deepseek/deepseek-v4.1-flash-1017
# A free alternative: particle-ai/particle-1:free
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash-1017

# Optional
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TEMPERATURE=0.2
OPENROUTER_MAX_TOKENS=65536
# Reasoning budget for reasoning-capable models
# (none|minimal|low|medium|high|max). Defaults to "low"; setting it explicitly to
# an empty value repeats the default. The upstream model default is often "high";
# on this workload that spent ~90% of completion tokens on hidden reasoning.
# "none" is ~8x cheaper and ~10x faster than "high" here. "low" saves ~10-30% tokens
# than "high" with similar time and quality.
OPENROUTER_REASONING_EFFORT=low
OPENROUTER_TIMEOUT_MS=300000
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=mantis
# Optional JSON provider-routing object, passed through to OpenRouter.
# OPENROUTER_PROVIDER={"order":["google-vertex"]}

# Required: selects prompts/<version>-*.md (e.g. v014, v015).
PROMPT_VERSION=v015
PROMPT_DIR=prompts
# Upload safety cap (bytes). Separate from the pixel resize below.
MAX_UPLOAD_BYTES=10485760
# Longest side sent to the VLM. Larger images are downscaled proportionally.
MAX_IMAGE_DIMENSION=1568
MAX_CONCURRENCY=4
MAX_QUEUE=32
RETRY_ON_INVALID_SVG=1
REQUEST_TIMEOUT_MS=150000

# SQLite database used for conversion review data. Use :memory: to disable persistence.
DATABASE_PATH=data/vector.db
# Developer review UI at /review. Disable in public deployments.
REVIEW_UI_ENABLED=true
# Allow the review UI to write local publication bundles. Disable in public deployments.
PUBLISH_ENABLED=true
# Local staging directory for publication manifests and assets. Gitignored.
PUBLISH_DIR=.publish
# Longest side of the downsampled WebP input thumbnails written when publishing.
PUBLISH_INPUT_DIMENSION=384
