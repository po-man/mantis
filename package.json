{
  "name": "vector",
  "version": "0.1.0",
  "description": "Lightweight image-to-SVG microservice backed by OpenRouter",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.8",
    "@fastify/swagger": "^9.9.4",
    "@fastify/swagger-ui": "^6.1.3",
    "cheerio": "^1.2.0",
    "fastify": "^5.12.8",
    "file-type": "^22.3.0",
    "saxes": "^6.0.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "undici": "^8.12.4",
    "vitest": "^5.1.0"
  }
}
